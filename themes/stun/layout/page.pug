extends ./_layout.pug

block content
  include ./_mixins/gallery.pug

  if page.type === 'tags'
    div.tagcloud
      h1.tagcloud-total= __('page.tags') + ' · '
        span= site.tags.length
      - var tags = site.tags.toArray().sort(function (a, b) { return b.posts.length - a.posts.length; });
      div.tagcloud-chips
        each tag in tags
          a.tagcloud-chip(class=tag.posts.length >= 2 ? 'is-hot' : '' href=url_for(tag.path))
            span.tagcloud-chip__name= tag.name
            span.tagcloud-chip__count= tag.posts.length
  else if page.type === 'categories'
    div.category
      h1.category-total= __('page.categories') + ' · '
        span= site.categories.length
      div.category-grid
        each cat, ci in site.categories.toArray()
          - var palette = ['#3b82f6', '#8b5cf6', '#10b981', '#f59e0b', '#ef4444', '#06b6d4']
          - var color = palette[ci % palette.length]
          a.category-card(href=url_for(cat.path) style='--cat-color: ' + color)
            span.category-card__icon
              i.fas.fa-folder-open
            div.category-card__info
              span.category-card__name= cat.name
              span.category-card__desc= cat.posts.length + ' 篇文章'
            i.fas.fa-arrow-right.category-card__arrow
  else if page.type === 'ai-nav'
    - var nav = site.data['ai-nav']
    div.ai-nav
      h1.page-h1= page.title
      if page.description
        p.ai-nav-intro= page.description
      div.ai-nav-search
        i.fas.fa-search.ai-nav-search-icon
        input#ai-nav-filter(type="text" placeholder="搜索工具或功能，如 PPT、生图" autocomplete="off" aria-label="搜索工具")
        span#ai-nav-count.ai-nav-count= nav.categories.reduce((s, c) => s + c.tools.length, 0)
        button#ai-nav-search-btn.ai-nav-search-btn.is-kbd(type="button" aria-label="聚焦搜索") /
      nav.ai-nav-tabs
        -
          var catIcons = {
            chat: 'fas fa-comments',
            coding: 'fas fa-code',
            image: 'fas fa-image',
            video: 'fas fa-video',
            writing: 'fas fa-pen-nib',
            office: 'fas fa-briefcase',
            search: 'fas fa-search',
            design: 'fas fa-palette',
            audio: 'fas fa-music',
            platform: 'fas fa-cubes',
            agent: 'fas fa-robot'
          };
        each cat in nav.categories
          a.ai-nav-tab(href='#cat-' + cat.id)
            i(class=catIcons[cat.id] || 'fas fa-shapes')
            span= cat.name
      each cat in nav.categories
        section.ai-nav-section(id='cat-' + cat.id)
          h2.ai-nav-section-title
            = cat.name
            if cat.desc
              span.ai-nav-section-desc= cat.desc
          div.ai-nav-grid
            each tool, ti in cat.tools
              - var palette = ['#3b82f6', '#8b5cf6', '#10b981', '#f59e0b', '#ef4444', '#06b6d4', '#ec4899', '#84cc16']
              - var color = palette[(ti * 3 + nav.categories.indexOf(cat)) % palette.length]
              div.ai-nav-card(data-search=(tool.name + ' ' + tool.desc + ' ' + cat.name).toLowerCase())
                a.ai-nav-card-main(href=tool.url target="_blank" rel="noopener noreferrer nofollow")
                  span.ai-nav-avatar(style="background:" + color)= tool.name.charAt(0)
                  span.ai-nav-info
                    span.ai-nav-name
                      = tool.name
                      if tool.hot
                        i.fas.fa-fire.ai-nav-hot(title="热门")
                    span.ai-nav-desc= tool.desc
                if tool.tested
                  a.ai-nav-badge(href=url_for(tool.tested))
                    i.fas.fa-check-circle
                    | 看实测教程
      p.ai-nav-empty(id="ai-nav-empty" style="display:none") 没有匹配的工具，换个关键词试试
      // SEO：选型指南 + FAQ 正文块（index.md 正文渲染在工具列表下方，补足成段文本内容）
      if page.content
        div.ai-nav-content
          != page.content
          p.ai-nav-updated
            |
            | 最后更新：<time datetime="#{date(page.updated || page.date, 'YYYY-MM-DD')}">#{date(page.updated || page.date, 'YYYY-MM-DD')}</time> · 收录 #{nav.categories.reduce((s, c) => s + c.tools.length, 0)} 个工具 · 访问
            span.ai-nav-pv(id="busuanzi_value_page_pv") --
            |
            | 次
    // SEO：ItemList 结构化数据，由 ai-nav.yml 自动生成
    -
      var itemList = {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": page.title,
        "description": page.description || '',
        "itemListElement": []
      };
      var pos = 0;
      // SEO：url 去重——同一 URL 出现在多个分类（如 Kimi 与 Kimi PPT 助手）时，
      // 仅首条输出 url 字段（ListItem.url 可选），避免 Rich Results Test 报「重复的属性值」
      var seenUrls = {};
      nav.categories.forEach(function (cat) {
        cat.tools.forEach(function (tool) {
          var item = {
            "@type": "ListItem",
            "position": ++pos,
            "name": tool.name
          };
          if (!seenUrls[tool.url]) {
            seenUrls[tool.url] = true;
            item.url = tool.url;
          }
          itemList.itemListElement.push(item);
        });
      });
      itemList.numberOfItems = pos;
    script(type="application/ld+json").
      !{JSON.stringify(itemList)}
    // SEO：FAQPage 结构化数据（与正文「常见问题」3 问保持同步）
    -
      var aiNavFaq = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "这个页面会持续更新吗？", "acceptedAnswer": { "@type": "Answer", "text": "会。工具停止服务会移除，值得关注的新工具会补进来，页面上标注了最后更新时间和收录总数。建议收藏本页，需要时回来查最新版本。" } },
          { "@type": "Question", "name": "为什么有些知名工具没有收录？", "acceptedAnswer": { "@type": "Answer", "text": "本站只收录自己确认过官方网址和基本可用性的工具，宁缺毋滥。工具导航站最怕死链，缺一个工具的损失远小于点开一条失效链接。" } },
          { "@type": "Question", "name": "「实测」标记是什么意思？", "acceptedAnswer": { "@type": "Answer", "text": "表示这个工具本站深度用过，并写成了完整教程。徽章直接链到对应文章，配置步骤、避坑点、适用人群都在里面。" } }
        ]
      };
    script(type="application/ld+json").
      !{JSON.stringify(aiNavFaq)}
    script.
      (function () {
        var input = document.getElementById('ai-nav-filter');
        var cards = document.querySelectorAll('.ai-nav-card');
        var sections = document.querySelectorAll('.ai-nav-section');
        var empty = document.getElementById('ai-nav-empty');
        var count = document.getElementById('ai-nav-count');
        var wrap = document.querySelector('.ai-nav-search');
        var btn = document.getElementById('ai-nav-search-btn');
        var total = cards.length;

        // 清除按钮 / 快捷键提示的三态切换
        function syncBtn() {
          var has = !!input.value;
          wrap.classList.toggle('has-value', has);
          if (has) {
            btn.textContent = '\u00d7';
            btn.className = 'ai-nav-search-btn is-clear';
            btn.setAttribute('aria-label', '清空搜索');
            btn.hidden = false;
          } else {
            btn.textContent = '/';
            btn.className = 'ai-nav-search-btn is-kbd';
            btn.setAttribute('aria-label', '聚焦搜索');
            // 聚焦输入中不显示 / 提示，避免干扰
            btn.hidden = document.activeElement === input;
          }
        }

        function renderCount(shown) {
          count.textContent = shown === total ? String(total) : shown + ' / ' + total;
        }

        function applyFilter() {
          var kw = input.value.trim().toLowerCase();
          var shown = 0;
          cards.forEach(function (card) {
            var hit = !kw || card.getAttribute('data-search').indexOf(kw) !== -1;
            card.style.display = hit ? '' : 'none';
            if (hit) shown++;
          });
          sections.forEach(function (sec) {
            var any = sec.querySelectorAll('.ai-nav-card:not([style*="none"])').length > 0;
            sec.style.display = any ? '' : 'none';
          });
          empty.style.display = shown === 0 ? '' : 'none';
          renderCount(shown);
        }

        input.addEventListener('input', function () {
          applyFilter();
          syncBtn();
        });
        input.addEventListener('focus', syncBtn);
        input.addEventListener('blur', syncBtn);

        // 清空并聚焦 / 聚焦
        btn.addEventListener('click', function () {
          if (input.value) {
            input.value = '';
            applyFilter();
          }
          input.focus();
          syncBtn();
        });

        // 全局快捷键：/ 聚焦搜索；输入框内 Esc 清空或退出
        document.addEventListener('keydown', function (e) {
          var tag = document.activeElement ? document.activeElement.tagName : '';
          if (e.key === '/' && document.activeElement !== input && !/INPUT|TEXTAREA|SELECT/.test(tag)) {
            e.preventDefault();
            input.focus();
          }
        });
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            if (input.value) {
              input.value = '';
              applyFilter();
              syncBtn();
            } else {
              input.blur();
            }
          }
        });

        syncBtn();
      })();
    script.
      (function () {
        var tabs = document.querySelector('.ai-nav-tabs');
        var links = tabs ? tabs.querySelectorAll('.ai-nav-tab') : [];
        var sections = document.querySelectorAll('.ai-nav-section');
        if (!tabs || !links.length) return;

        function setActive(link, center) {
          for (var i = 0; i < links.length; i++) {
            if (links[i] !== link) links[i].classList.remove('active');
          }
          link.classList.add('active');
          if (center) link.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }

        var suppressUntil = 0;

        // 点击：平滑滚到分类（区块的 scroll-margin-top 处理吸顶偏移）
        tabs.addEventListener('click', function (e) {
          var link = e.target.closest ? e.target.closest('.ai-nav-tab') : null;
          if (!link) return;
          e.preventDefault();
          var sec = document.getElementById(link.getAttribute('href').slice(1));
          suppressUntil = Date.now() + 700;
          if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          setActive(link, true);
        });

        // 滚动联动：视野顶部的分类对应胶囊高亮并自动居中
        var ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            ticking = false;
            if (Date.now() < suppressUntil) return;
            var current = null;
            for (var i = 0; i < sections.length; i++) {
              var rect = sections[i].getBoundingClientRect();
              if (!rect.height) continue;
              if (rect.top <= 170) current = sections[i];
              else break;
            }
            if (!current) return;
            var target = tabs.querySelector('a[href="#' + current.id + '"]');
            if (target && !target.classList.contains('active')) setActive(target, true);
          });
        }, { passive: true });

        // 滚轮横滑：未到边缘时把竖向滚轮转为横向，到边缘自然放行竖向滚页
        tabs.addEventListener('wheel', function (e) {
          if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          var max = tabs.scrollWidth - tabs.clientWidth;
          if (max <= 0) return;
          var canMove = e.deltaY > 0 ? tabs.scrollLeft < max - 1 : tabs.scrollLeft > 1;
          if (canMove) {
            e.preventDefault();
            tabs.scrollLeft += e.deltaY;
          }
        }, { passive: false });

        // 初始高亮第一个分类
        setActive(links[0], false);
      })();
  else
    div.custompage
      if page.title
        h1.page-h1= page.title
      if page.photos && page.photos.length
        +gallery(page)
      != page.content

  if isShowReward
    include ./_partials/widgets/reward.pug

  if isShowCC
    include ./_partials/widgets/copyright.pug
