-
  // 是否渲染文章目录卡（post 页默认开，可用 page.toc: false 关掉）
  var isShowToc = page.toc === true;

  if (typeof page.toc !== 'boolean') {
    isShowToc = theme.toc.enable && is_post();
  }

// ov = overview
// 布局仿 Butterfly 卡片化侧栏：名片卡 / 最新文章卡 / 分类卡 / 标签云卡 / 订阅卡
// 名片卡不吸附（随页面滚走），下方卡片包进 .sidebar-sticky 吸附——与 whitee.cn 一致
// 文章页不再用 tab 切换：概览常驻左栏，目录卡在宽屏悬浮到正文右侧
section.sidebar-ov
  // ---- 卡片 1：作者名片（不吸附） ----
  div.sidebar-ov-card.sidebar-card-author
    if theme.author.enable
      if theme.author.avatar.url
        div.sidebar-ov-author__avatar
          img(
            class="sidebar-ov-author__avatar_img"
            src=theme.author.avatar.url
            alt="avatar"
          )
      div.sidebar-card-author__name= theme.author.name || config.author
      if theme.author.motto
        p.sidebar-card-author__desc= theme.author.motto
    // 统计三项横排（文章 / 分类 / 标签）
    div.sidebar-card-author__data
      -
        var statLinks = {
          posts: (theme.menu.archives || '/archives/').split('||')[0].trim(),
          categories: (theme.menu.categories || '/categories/').split('||')[0].trim(),
          tags: (theme.menu.tags || '/tags/').split('||')[0].trim()
        };
      a.sidebar-card-data__item(href=url_for(statLinks.posts))
        span.sidebar-card-data__num= site.posts.length
        span.sidebar-card-data__label 文章
      a.sidebar-card-data__item(href=url_for(statLinks.categories))
        span.sidebar-card-data__num= site.categories.length
        span.sidebar-card-data__label 分类
      a.sidebar-card-data__item(href=url_for(statLinks.tags))
        span.sidebar-card-data__num= site.tags.length
        span.sidebar-card-data__label 标签
    // Follow Me 按钮（指向 GitHub 仓库）
    if theme.social && theme.social.github
      -
        var githubUrl = (theme.social.github.split('||')[0] + '').trim();
      a.sidebar-card-author__follow(href=githubUrl target="_blank" rel="noopener")
        i.fab.fa-github
        span Follow Me

  // ---- sticky 组：以下卡片吸附滚动（仿 Butterfly .sticky_layout） ----
  div.sidebar-sticky
    // ---- 卡片 2：最新文章 ----
    div.sidebar-ov-card
      div.sidebar-card__headline
        i.fas.fa-history
        span 最新文章
      ul.sidebar-card-posts
        -
          var recentPosts = site.posts.sort('date', -1).limit(5).toArray();
        each post in recentPosts
          li.sidebar-card-posts__item
            a.sidebar-card-posts__title(href=url_for(post.path))= post.title
            span.sidebar-card-posts__date= date(post.date, 'YYYY-MM-DD')

    // ---- 卡片 3：分类 ----
    div.sidebar-ov-card
      div.sidebar-card__headline
        i.fas.fa-folder-open
        span 分类
      ul.sidebar-card-cats
        each cat in site.categories.toArray()
          li.sidebar-card-cats__item
            a(href=url_for(cat.path))
              span.sidebar-card-cats__name= cat.name
              span.sidebar-card-cats__count= cat.posts.length

    // ---- 卡片 4：标签云 ----
    if site.tags.length
      div.sidebar-ov-card
        div.sidebar-card__headline
          i.fas.fa-tags
          span 标签
        div.sidebar-card-tags
          each tag in site.tags.toArray()
            a.sidebar-card-tags__item(href=url_for(tag.path))= tag.name

    // ---- 卡片 5：RSS 订阅 ----
    if theme.feed.enable
      div.sidebar-ov-card
        if theme.feed.rss
          div.sidebar-card__headline
            i.fas.fa-rss
            span RSS 订阅
          div.sidebar-card-feed
            a(
              href=url_for(theme.feed.rss)
              target="_blank"
              rel="noopener"
            ) 使用 RSS 阅读器订阅本站更新

    if theme.creative_commons.enable && theme.creative_commons.sidebar
      div.sidebar-ov-cc
        a(
          href=ccUrl
          target="_blank"
          rel="noopener"
          data-popover=__('popover.creative_commons')
          data-popover-pos="up"
        )
          img(src=url_for(`/${theme.images}/cc-${ccLicense}.svg`))

    // ---- 文章目录卡 ----
    // 宽屏（≥1680px）悬浮在正文右侧（fixed，脱离本容器）；
    // 中窄屏留在 sticky 组内，显示在概览卡片组下方
    if isShowToc && page.content
      -
        var tocMaxDepth = page.toc_max_depth || theme.toc.max_depth || 6;
        var tocMinDepth = page.toc_min_depth || theme.toc.min_depth || 1;
      div.sidebar-ov-card.sidebar-toc
        div.sidebar-card__headline
          i.fas.fa-stream
          span= __('sidebar.catalog')
        != toc(page.content, {list_number: theme.toc.list_number, min_depth: tocMinDepth, max_depth: tocMaxDepth})
        if theme.reading_progress.enable
          div.sidebar-reading
            div.sidebar-reading-info
              span.sidebar-reading-info__text= __('sidebar.read_info') + ' '
              span.sidebar-reading-info__num= '0'
              span.sidebar-reading-info__perc= '%'
            div.sidebar-reading-line
