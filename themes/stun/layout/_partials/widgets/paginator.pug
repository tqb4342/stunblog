nav(class=`${is_post() ? 'post-paginator' : ''}`).paginator
  if !is_post()
    - var prevText = `<i class="${theme.icon.paginator_prev}"></i>`;
    - var nextText = `<i class="${theme.icon.paginator_next}"></i>`;
    div.paginator-inner
      != paginator({ prev_text: prevText, next_text: nextText, mid_size: 1, escape: false })
  else
    // 上一篇/下一篇：单条横幅左右分布（仿 whitee.cn / Butterfly），样式在 custom.css
    div.post-paginator-bar
      if page.prev
        a.post-paginator-bar__item.post-paginator-bar__item--prev(href=url_for(page.prev.path))
          span.post-paginator-bar__label 上一篇
          span.post-paginator-bar__title= page.prev.title || __('post.untitled')
      if page.next
        a.post-paginator-bar__item.post-paginator-bar__item--next(href=url_for(page.next.path))
          span.post-paginator-bar__label 下一篇
          span.post-paginator-bar__title= page.next.title || __('post.untitled')
