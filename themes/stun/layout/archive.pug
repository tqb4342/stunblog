extends ./_layout.pug
include ./_mixins/archive-timeline.pug

block content
  div.archive
    h1.page-h1.archive-title= __('sidebar.archives') + ' · '
      span= site.posts.length
    p.archive-sub 按时间倒序排列 · 持续更新中

    - var posts = theme.post_list.paginate.archives ? page.posts.data : site.posts.data;
    +archive-timeline(posts)
