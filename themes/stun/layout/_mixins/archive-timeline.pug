//- 归档页同款时间线：年份渐变徽章 + 计数胶囊 + 行卡片（archive / category / tag 共用）
//- CSS 作用域为 .archive —— 调用方容器必须挂 .archive 类
mixin archive-timeline(posts)
  //- 置顶优先 + 时间倒序
  - var sortPosts = [];
  each post in posts
    if sortPosts.length === 0
      - sortPosts.push(post)
    else
      each sPost, index in sortPosts
        - var isBigTime = new Date(post.date).getTime() > new Date(sPost.date).getTime();
        if post.top
          if !sPost.top || isBigTime
            - sortPosts.splice(index, 0, post)
            - break
          else if index + 1 === sortPosts.length
            - sortPosts.push(post)
            - break
        else
          if !sPost.top && isBigTime
            - sortPosts.splice(index, 0, post)
            - break
          else if index + 1 === sortPosts.length
            - sortPosts.push(post)
            - break

  //- 年份文章数统计
  - var yearCount = {};
  each post in sortPosts
    if post.date
      - var y = full_date(post.date, 'YYYY');
      - yearCount[y] = (yearCount[y] || 0) + 1;

  section.timeline.archive-timeline
    - var year, tmpYear;
    each post in sortPosts
      if post.date
        - tmpYear = full_date(post.date, 'YYYY')
      if tmpYear !== year
        - year = tmpYear
        div.timeline-year
          span.timeline-year__num= year
          span.timeline-year__count= yearCount[year] + ' 篇'
      article.timeline-item
        if post.date
          time.timeline-item__time(datetime=date_xml(post.date))= full_date(post.date, 'MM-DD')
          h2.timeline-item__title
            if post.link
              a.timeline-item__link(
                href=url_for(post.link)
                target="_blank"
                rel="noopener"
              )= post.title || post.link
            else
              a.timeline-item__link(
                href=url_for(post.path)
              )= post.title || __('post.untitled')
        if post.top
          include ../_partials/widgets/sticky-top.pug
