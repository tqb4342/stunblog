{
  "name": "stunblog",
  "compatibility_date": "2026-11-01",
  // Worker 入口：处理 /api/pv 计数接口，其余请求自动走静态资产
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    // Worker 里通过 env.ASSETS.fetch() 兜底静态请求
    "binding": "ASSETS",
    // 未命中路径返回 404.html（此前 assets-only 模式未配置，404 页一直没生效，顺手修复）
    "not_found_handling": "404-page"
  },
  // 文章访问量 KV 存储（namespace: pv-counter）
  // 2026-11-15 起计数迁至 Durable Object；KV 仅保留给 DO 首次启动导入存量，导入完成可移除
  "kv_namespaces": [
    { "binding": "COUNTER", "id": "9ef3312d07644aeb9d367d7db3e7723c" }
  ],
  // 访问量计数 Durable Object（SQLite 存储，免费档 10 万行写/天，替代 KV 的 1000 写/天）
  "durable_objects": {
    "bindings": [{ "name": "COUNTER_DO", "class_name": "CounterDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CounterDO"] }]
}
